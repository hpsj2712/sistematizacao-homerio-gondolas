e. 'yolo settings runs_dir=path/to/dir'. For help see https://docs.ultralytics.com/usage/settings.\n🚀 Carregando o ambiente do App Gradio...\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"\n\n# 2. Localizar automaticamente os melhores pesos salvos do seu dataset\ndef find_best_weights():\n    # Busca por pesos de segmentação no Kaggle Input ou Working\n    seg_candidates = glob.glob(\"/kaggle/input/**/best_segmentation.pt\", recursive=True) + \\\n                    glob.glob(\"/kaggle/input/**/best_*.pt\", recursive=True) + \\\n                    glob.glob(\"/kaggle/working/**/*.pt\", recursive=True)\n    \n    det_candidates = glob.glob(\"/kaggle/input/**/best_detection.pt\", recursive=True) + \\\n                    glob.glob(\"/kaggle/working/**/*.pt\", recursive=True)\n\n    seg_w = seg_candidates[0] if seg_candidates else \"yolo11n-seg.pt\"\n    det_w = det_candidates[0] if det_candidates else \"yolo11n.pt\"\n    \n    return seg_w, det_w\n\nseg_weight_path, det_weight_path = find_best_weights()\n\nprint(f\"📦 Modelo de Segmentação carregado: '{seg_weight_path}'\")\nprint(f\"📦 Modelo de Detecção carregado: '{det_weight_path}'\")\n\n# Carregar os modelos YOLO\nmodel_seg = YOLO(seg_weight_path)\nmodel_det = YOLO(det_weight_path)\n\n# Mapeamento e Cores para as 4 classes do projeto\nCLASS_NAMES = {0: \"garrafa\", 1: \"pacote\", 2: \"fardo_caixa\", 3: \"vazio\"}\n\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T17:26:49.262192Z","iopub.execute_input":"2026-09-20T17:26:49.262549Z","iopub.status.idle":"2026-09-20T17:26:53.39581Z","shell.execute_reply.started":"2026-09-20T17:26:49.262516Z","shell.execute_reply":"2026-09-20T17:26:53.394943Z"}},"outputs":[{"name":"stdout","text":"📦 Modelo de Segmentação carregado: '/kaggle/input/datasets/homeriojr/sistematizacao-visao-yolo11-retail-shelf-weights/best_segmentation.pt'\n📦 Modelo de Detecção carregado: '/kaggle/input/datasets/homeriojr/sistematizacao-visao-yolo11-retail-shelf-weights/best_detection.pt'\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"# ------------------------------------------------------------------------------\n# 3. Funções de Processamento de Mídia\n# ------------------------------------------------------------------------------\n\ndef processar_imagem(image, conf_threshold, iou_threshold, exibir_mascaras):\n    \"\"\"\n    Processa a imagem de entrada e retorna o resultado anotado + tabela de inventário.\n    \"\"\"\n    if image is None:\n        return None, \"Nenhuma imagem fornecida.\"\n\n    # Converter imagem PIL / numpy RGB para BGR para o OpenCV\n    img_bgr = cv2.cvtColor(np.array(image), cv2.COLOR_RGB2BGR)\n    \n    # Escolher o modelo com base no checkbox de máscaras\n    model = model_seg if exibir_mascaras else model_det\n    \n    # Inferência com limiares ajustáveis pelo usuário\n    results = model.predict(\n        source=img_bgr,\n        conf=conf_threshold,\n        iou=iou_threshold,\n        verbose=False\n    )[0]\n\n    # Desenhar predições na imagem (Máscaras ou Caixas)\n    img_annotated_bgr = results.plot()\n    img_annotated_rgb = cv2.cvtColor(img_annotated_bgr, cv2.COLOR_BGR2RGB)\n\n    # Contagem dos objetos por classe no inventário\n    counts = {name: 0 for name in CLASS_NAMES.values()}\n    \n    if results.boxes is not None and len(results.boxes) > 0:\n        classes_detected = results.boxes.cls.cpu().numpy().astype(int)\n        for cls_id in classes_detected:\n            name = CLASS_NAMES.get(cls_id, f\"Classe_{cls_id}\")\n            counts[name] = counts.get(name, 0) + 1\n\n    # Formatar resumo de estoque\n    df_counts = pd.DataFrame(list(counts.items()), columns=[\"Categoria de Produto\", \"Quantidade Detectada\"])\n    \n    total_produtos = sum([v for k, v in counts.items() if k != \"vazio\"])\n    total_vazios = counts.get(\"vazio\", 0)\n    \n    resumo_texto = f\"📊 **Resumo da Auditoria de Prateleira:**\\n\"\n    resumo_texto += f\"- **Total de Produtos Identificados:** {total_produtos}\\n\"\n    resumo_texto += f\"- **Rupturas / Espaços Vazios Detectados:** {total_vazios}\\n\"\n\n    return img_annotated_rgb, df_counts, resumo_texto\n\n\ndef processar_video(video_path, conf_threshold):\n    \"\"\"\n    Processa um arquivo de vídeo frame a frame gerando rastreamento ByteTrack.\n    \"\"\"\n    if video_path is None:\n        return None\n\n    # Processar o vídeo salvando em /kaggle/working\n    out_dir = \"/kaggle/working/gradio_video_output\"\n    os.makedirs(out_dir, exist_ok=True)\n    \n    results = model_seg.track(\n        source=video_path,\n        tracker=\"bytetrack.yaml\",\n        conf=conf_threshold,\n        save=True,\n        project=out_dir,\n        name=\"run\",\n        exist_ok=True\n    )\n    \n    # Caminho do vídeo final gerado pelo Ultralytics\n    out_video_path = glob.glob(f\"{out_dir}/run/*.mp4\") + glob.glob(f\"{out_dir}/run/*.avi\")\n    \n    if out_video_path:\n        return out_video_path[0]\n    return video_path\n\n\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T17:26:53.396995Z","iopub.execute_input":"2026-09-20T17:26:53.397366Z","iopub.status.idle":"2026-09-20T17:26:53.407484Z","shell.execute_reply.started":"2026-09-20T17:26:53.397338Z","shell.execute_reply":"2026-09-20T17:26:53.406714Z"}},"outputs":[],"execution_count":3},{"cell_type":"code","source":"# ------------------------------------------------------------------------------\n# 4. Construção da Interface Grafica (Gradio Blocks)\n# ------------------------------------------------------------------------------\n\ncustom_css = \"\"\"\nfooter {visibility: hidden}\n.gr-button-primary {background-color: #2b5c8f !important;}\n\"\"\"\n\nwith gr.Blocks(title=\"Auditoria de Gôndolas - Visão Computacional\", css=custom_css) as demo:\n    \n    gr.Markdown(\n        \"\"\"\n        # 🛒 Sistema Inteligente de Auditoria e Segmentação de Gôndolas\n        ### **Trabalho de Visão Computacional — Detecção e Segmentação de Instâncias (YOLO11 & SAM)**\n        Carregue uma **Imagem** ou **Vídeo** de prateleira para identificar produtos (`garrafa`, `pacote`, `fardo_caixa`) e rupturas de estoque (`vazio`).\n        \"\"\"\n    )\n\n    with gr.Tabs():\n        \n        # 📷 ABA 1: AUDITORIA DE IMAGENS\n        with gr.TabItem(\"🖼️ Análise por Imagem\"):\n            with gr.Row():\n                with gr.Column(scale=1):\n                    img_input = gr.Image(label=\"Enviar Imagem da Gôndola\", type=\"pil\")\n                    \n                    with gr.Accordion(\"⚙️ Configurações e Limiares\", open=True):\n                        conf_slider = gr.Slider(minimum=0.1, maximum=1.0, value=0.25, step=0.05, label=\"Limiar de Confiança (Confidence)\")\n                        iou_slider = gr.Slider(minimum=0.1, maximum=1.0, value=0.45, step=0.05, label=\"Limiar de Sobreposição (IoU)\")\n                        chk_mascaras = gr.Checkbox(value=True, label=\"Exibir Máscaras de Segmentação (YOLO11-Seg)\")\n                    \n                    btn_analisar_img = gr.Button(\"🚀 Executar Auditoria Visual\", variant=\"primary\")\n\n                with gr.Column(scale=1):\n                    img_output = gr.Image(label=\"Resultado da Segmentação / Detecção\")\n                    resumo_output = gr.Markdown()\n                    tabla_output = gr.Dataframe(label=\"Inventário do Frame\")\n\n            btn_analisar_img.click(\n                fn=processar_imagem,\n                inputs=[img_input, conf_slider, iou_slider, chk_mascaras],\n                outputs=[img_output, tabla_output, resumo_output]\n            )\n\n        # 🎬 ABA 2: INFERÊNCIA EM VÍDEO REAL\n        with gr.TabItem(\"🎥 Rastreamento em Vídeo (ByteTrack)\"):\n            with gr.Row():\n                with gr.Column(scale=1):\n                    vid_input = gr.Video(label=\"Enviar Vídeo da Gôndola (.mp4)\")\n                    vid_conf_slider = gr.Slider(minimum=0.1, maximum=1.0, value=0.25, step=0.05, label=\"Limiar de Confiança\")\n                    btn_analisar_vid = gr.Button(\"🎬 Processar Vídeo com Rastreamento\", variant=\"primary\")\n\n                with gr.Column(scale=1):\n                    vid_output = gr.Video(label=\"Resultado do Vídeo com Máscaras e Rastreamento\")\n\n            btn_analisar_vid.click(\n                fn=processar_video,\n                inputs=[vid_input, vid_conf_slider],\n                outputs=[vid_output]\n            )\n\n    gr.Markdown(\n        \"\"\"\n        ---\n        **Estrutura de Classes:** `0: garrafa` | `1: pacote` | `2: fardo_caixa` | `3: vazio`  \n        **Modelos Utilizados:** YOLO11-Nano Fine-Tuned + Polígonos de Máscara SAM (*Segment Anything Model*).\n        \"\"\"\n    )\n\n# Disparar a aplicação com link público\ndemo.launch(share=True, show_error=True)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T17:26:53.408792Z","iopub.execute_input":"2026-09-20T17:26:53.409181Z","iopub.status.idle":"2026-09-20T17:26:55.284364Z","shell.execute_reply.started":"2026-09-20T17:26:53.409123Z","shell.execute_reply":"2026-09-20T17:26:55.283536Z"}},"outputs":[{"name":"stderr","text":"/tmp/ipykernel_58/826362905.py:10: UserWarning: The parameters have been moved from the Blocks constructor to the launch() method in Gradio 6.0: css. Please pass these parameters to launch() instead.\n  with gr.Blocks(title=\"Auditoria de Gôndolas - Visão Computacional\", css=custom_css) as demo:\n","output_type":"stream"},{"name":"stdout","text":"* Running on local URL:  http://127.0.0.1:7860\n* Running on public URL: https://90d65eb0d9380f5460.gradio.live\n\nThis share link is temporary and will last for up to 1 week (best effort). For free permanent hosting and GPU upgrades, run `gradio deploy` from the terminal in the working directory to deploy to Hugging Face Spaces (https://huggingface.co/spaces)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/p