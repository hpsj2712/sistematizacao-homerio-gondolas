ith open(lbl_path, \"r\") as f:\n        labels = [line.strip() for line in f.readlines() if line.strip()]\n    \n    num_objects = len(labels)\n    if num_objects == 0:\n        continue  # Descarta imagens sem nenhuma anotação\n\n    # Carregar imagem para avaliação visual\n    img = cv2.imread(img_path)\n    if img is None:\n        continue\n    \n    # Cálculo de Nitidez/Foco via Variação do Laplaciano\n    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n    sharpness = cv2.Laplacian(gray, cv2.CV_64F).var()\n    \n    # Score combinado: valoriza imagens mais nítidas e com boa quantidade de objetos\n    score = sharpness * (1 + 0.05 * num_objects)\n    \n    image_metrics.append({\n        'img_path': img_path,\n        'lbl_path': lbl_path,\n        'num_objects': num_objects,\n        'sharpness': sharpness,\n        'score': score\n    })\n\n# Ordenar da melhor para a pior pontuação\nimage_metrics.sort(key=lambda x: x['score'], reverse=True)\n\n# Separar as melhores imagens\nTOP_N = 450\nselected_images = image_metrics[:TOP_N]\n\nprint(f\"📊 Processamento concluído!\")\nprint(f\"✅ Total de imagens qualificadas: {len(image_metrics)}\")\nprint(f\"🎯 Selecionadas as TOP {len(selected_images)} melhores imagens para o projeto.\")\n\n# Pasta onde o dataset refinado será salvo\noutput_dir = \"/kaggle/working/selected_dataset\"\nif os.path.exists(output_dir):\n    shutil.rmtree(output_dir)\n\nos.makedirs(os.path.join(output_dir, \"images\"), exist_ok=True)\nos.makedirs(os.path.join(output_dir, \"labels\"), exist_ok=True)\n\n# Copiar imagens e rótulos selecionados aplicando o novo padrão de nome (img_visao_001.jpg)\nfor idx, item in enumerate(selected_images, start=1):\n    ext = os.path.splitext(item['img_path'])[1]  # Mantém a extensão original (.jpg ou .png)\n    new_name = f\"img_visao_{idx:03d}\"\n    \n    dest_img_path = os.path.join(output_dir, \"images\", f\"{new_name}{ext}\")\n    dest_lbl_path = os.path.join(output_dir, \"labels\", f\"{new_name}.txt\")\n    \n 