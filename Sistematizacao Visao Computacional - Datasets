image/png":"\n"},"metadata":{}}],"execution_count":5},{"cell_type":"code","source":"# 3.2. Reanotação de Detecção com Heurística Geométrica + 3 Splits (Train / Val / Test)\nimport os\nimport glob\nimport cv2\nimport shutil\nimport yaml\nfrom sklearn.model_selection import train_test_split\n\nNEW_CLASSES = {\n    0: \"garrafa\",\n    1: \"pacote\",\n    2: \"fardo_caixa\",\n    3: \"vazio\"\n}\n\ndet_dataset_dir = \"/kaggle/working/detected_dataset\"\n\n# Limpar e recriar estrutura com os 3 splits exigidos pelo projeto\nif os.path.exists(det_dataset_dir):\n    shutil.rmtree(det_dataset_dir)\n\nfor split in [\"train\", \"val\", \"test\"]:\n    os.makedirs(os.path.join(det_dataset_dir, \"images\", split), exist_ok=True)\n    os.makedirs(os.path.join(det_dataset_dir, \"labels\", split), exist_ok=True)\n\nselected_imgs = glob.glob(\"/kaggle/working/selected_dataset/images/*.jpg\") + \\\n                glob.glob(\"/kaggle/working/selected_dataset/images/*.png\")\n\nprint(f\"🚀 Reanotando {len(selected_imgs)} imagens com heurística geométrica (4 classes) e dividindo em 3 splits...\")\n\n# 1º Split: Separa 70% para Treino e 30% para Validação + Teste\ntrain_imgs, temp_imgs = train_test_split(selected_imgs, test_size=0.30, random_state=42)\n\n# 2º Split: Divide os 30% igualmente em 15% Validação e 15% Teste\nval_imgs, test_imgs = train_test_split(temp_imgs, test_size=0.50, random_state=42)\n\ndef process_and_save_split(img_list, split_name):\n    processed_count = 0\n    for img_path in img_list:\n        base_name = os.path.splitext(os.path.basename(img_path))[0]\n        lbl_path = f\"/kaggle/working/selected_dataset/labels/{base_name}.txt\"\n        \n        if not os.path.exists(lbl_path):\n            continue\n\n        img = cv2.imread(img_path)\n        if img is None:\n            continue\n        img_h, img_w, _ = img.shape\n\n        new_labels = []\n        \n        with open(lbl_path, \"r\") as f:\n            for line in f.readlines():\n                parts = line.strip().split()\n                if len(parts) >= 5:\n                    cx, cy, w, h = map(float, parts[1:5])\n                    \n                    box_w = w * img_w\n                    box_h = h * img_h\n                    aspect_ratio = box_h / (box_w + 1e-6)\n                    inverse_aspect_ratio = box_w / (box_h + 1e-6)\n                    area_ratio = w * h\n\n                    if inverse_aspect_ratio >= 2.2:\n                        new_cls = 3  # vazio\n                    elif aspect_ratio >= 1.35:\n                        new_cls = 0  # garrafa\n                    elif area_ratio >= 0.08:\n                        new_cls = 2  # fardo_caixa\n                    else:\n                        new_cls = 1  # pacote\n                    \n                    new_labels.append(f\"{new_cls} {cx:.6f} {cy:.6f} {w:.6f} {h:.6f}\")\n\n        if new_labels:\n            processed_count += 1\n            # Salvar no subdiretório do split correspondente\n            out_lbl_path = os.path.join(det_dataset_dir, \"labels\", split_name, f\"{base_name}.txt\")\n            with open(out_lbl_path, \"w\") as f:\n                f.write(\"\\n\".join(new_labels))\n                \n            shutil.copy(img_path, os.path.join(det_dataset_dir, \"images\", split_name, f\"{base_name}.jpg\"))\n            \n    return processed_count\n\ncount_train = process_and_save_split(train_imgs, \"train\")\ncount_val = process_and_save_split(val_imgs, \"val\")\ncount_test = process_and_save_split(test_imgs, \"test\")\ntotal_processed = count_train + count_val + count_test\n\n# Configurar data.yaml apontando os 3 conjuntos\nyaml_content = {\n    'path': det_dataset_dir,\n    'train': 'images/train',\n    'val': 'images/val',\n    'test': 'images/test',\n    'nc': len(NEW_CLASSES),\n    'names': [NEW_CLASSES[i] for i in range(len(NEW_CLASSES))]\n}\n\nwith open(os.path.join(det_dataset_dir, \"data.yaml\"), 'w') as f:\n    yaml.dump(yaml_content, f, default_flow_style=Fal