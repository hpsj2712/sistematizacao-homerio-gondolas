.path.join(det_p, \"data.yaml\"), det_p, \"test_det_fixed.yaml\")\nyaml_seg_test = prepare_test_yaml(os.path.join(seg_p, \"data.yaml\"), seg_p, \"test_seg_fixed.yaml\")\n\n# 3. Avaliação Estrita - Detecção (YOLO11)\nprint(\"\\n📊 Executando avaliação no modelo de DETECÇÃO...\")\nmodel_det_eval = YOLO(det_w)\nmetrics_det = model_det_eval.val(\n    data=yaml_det_test,\n    split='test',\n    batch=16,\n    imgsz=640,\n    device=device_eval,\n    project=\"/kaggle/working/eval_test_results\",\n    name=\"detect_test_run\",\n    exist_ok=True,\n    plots=True,\n    verbose=False\n)\n\n# 4. Avaliação Estrita - Segmentação (YOLO11-Seg)\nprint(\"📊 Executando avaliação no modelo de SEGMENTAÇÃO...\")\nmodel_seg_eval = YOLO(seg_w)\nmetrics_seg = model_seg_eval.val(\n    data=yaml_seg_test,\n    split='test',\n    batch=16,\n    imgsz=640,\n    device=device_eval,\n    project=\"/kaggle/working/eval_test_results\",\n    name=\"segment_test_run\",\n    exist_ok=True,\n    plots=True,\n    verbose=False\n)\n\n# 5. Consolidação da Tabela de Métricas Quantitativas\n# Nota: IoU médio no YOLO é representado por mAP@0.5:0.95 no limiar de sobreposição\nresults_summary = [\n    {\n        \"Modelo / Tarefa\": \"YOLO11 Detecção (Box)\",\n        \"mAP@0.5\": round(float(metrics_det.box.map50), 4),\n        \"mAP@0.5:0.95 (IoU)\": round(float(metrics_det.box.map), 4),\n        \"Precisão\": round(float(metrics_det.box.p.mean()), 4),\n        \"Recall\": round(float(metrics_det.box.r.mean()), 4)\n    },\n    {\n        \"Modelo / Tarefa\": \"YOLO11 Segmentação (Box)\",\n        \"mAP@0.5\": round(float(metrics_seg.box.map50), 4),\n        \"mAP@0.5:0.95 (IoU)\": round(float(metrics_seg.box.map), 4),\n        \"Precisão\": round(float(metrics_seg.box.p.mean()), 4),\n        \"Recall\": round(float(metrics_seg.box.r.mean()), 4)\n    },\n    {\n        \"Modelo / Tarefa\": \"YOLO11 Segmentação (Mask)\",\n        \"mAP@0.5\": round(float(metrics_seg.seg.map50), 4),\n        \"mAP@0.5:0.95 (IoU)\": round(float(metrics_seg.seg.map), 4),\n        \"Precisão\": round(float(metrics_seg.seg.p.mean()), 4),\n        \"Recall\": round(float(metrics_seg.seg.r.mean()), 4)\n    }\n]\n\ndf_fase4 = pd.DataFrame(results_summary)\ncsv_fase4_path = \"/kaggle/working/metricas_fase4_test_set.csv\"\ndf_fase4.to_csv(csv_fase4_path, index=False)\n\nprint(\"\\n\" + \"=\"*75)\nprint(\"🏆 TABELA RESUMO DE AVALIAÇÃO - CONJUNTO DE TESTE (FASE 4)\")\nprint(\"=\"*75)\ndisplay(df_fase4)\nprint(\"=\"*75)\n\n# 6. Exibição das Matrizes de Confusão Geradas\nprint(\"\\n📌 Exibindo Matrizes de Confusão do Conjunto de Teste:\")\n\ncm_det_path = \"/kaggle/working/eval_test_results/detect_test_run/confusion_matrix.png\"\ncm_seg_path = \"/kaggle/working/eval_test_results/segment_test_run/confusion_matrix.png\"\n\nfig, axes = plt.subplots(1, 2, figsize=(16, 7))\n\nif os.path.exists(cm_det_path):\n    img_cm_det = cv2.cvtColor(cv2.imread(cm_det_path), cv2.COLOR_BGR2RGB)\n    axes[0].imshow(img_cm_det)\n    axes[0].set_title(\"Matriz de Confusão - Detecção\", fontsize=12, fontweight='bold')\n    axes[0].axis('off')\n\nif os.path.exists(cm_seg_path):\n    img_cm_seg = cv2.cvtColor(cv2.imread(cm_seg_path), cv2.COLOR_BGR2RGB)\n    axes[1].imshow(img_cm_seg)\n    axes[1].set_title(\"Matriz de Confusão - Segmentação\", fontsize=12, fontweight='bold')\n    axes[1].axis('off')\n\nplt.tight_layout()\nplt.show()\n\nprint(f\"✅ Tabela de métricas salva em: '{csv_fase4_path}'\")\nprint(\"📁 Todos os artefatos visuais (Curvas PR, F1 e Matrizes de Confusão) salvos em '/kaggle/working/eval_test_results/'\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-20T16:13:47.633644Z","iopub.execute_input":"2026-09-20T16:13:47.634591Z","iopub.status.idle":"2026-09-20T16:14:42.852463Z","shell.execute_reply.started":"2026-09-20T16:13:47.634527Z","shell.execute_reply":"2026-09-20T16:14:42.829818Z"}},"outputs":[{"name":"stdout","text":"🔍 Iniciando Avaliação Oficial no Conjunto de Teste (Test Set)...\n\n📊 